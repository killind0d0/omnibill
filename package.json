{
  "name": "omnibill",
  "version": "0.1.0",
  "description": "High-Performance, Zero-Float, Offline-First Desktop ERP & POS for Indian Retail & Wholesale",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix ui run dev",
    "dev:ui": "npm --prefix ui run dev",
    "serve:backend": "cargo run --manifest-path src-tauri/Cargo.toml --bin omnibill -- --serve 4000",
    "init:db": "cargo run --manifest-path src-tauri/Cargo.toml --bin omnibill -- --init",
    "audit:ledger": "cargo run --manifest-path src-tauri/Cargo.toml --bin omnibill -- --audit",
    "build": "npm --prefix ui run build",
    "build:ui": "npm --prefix ui run build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "test:cargo": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "erp",
    "pos",
    "gst",
    "offline-first",
    "accounting",
    "rea",
    "tauri",
    "rust",
    "sqlite",
    "escpos"
  ],
  "author": "OmniBill Engineering Team",
  "license": "MIT"
}
